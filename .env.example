# Appwrite Configuration
NUXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NUXT_PUBLIC_APPWRITE_PROJECT_ID=your-project-id-here

# Database Configuration
NUXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id-here

# Collection IDs for TechTerview
NUXT_PUBLIC_APPWRITE_USERS_COLLECTION_ID=users
NUXT_PUBLIC_APPWRITE_INTERVIEWS_COLLECTION_ID=interviews
NUXT_PUBLIC_APPWRITE_QUESTIONS_COLLECTION_ID=questions
NUXT_PUBLIC_APPWRITE_RESPONSES_COLLECTION_ID=responses
NUXT_PUBLIC_APPWRITE_SESSIONS_COLLECTION_ID=sessions

# Storage Configuration
NUXT_PUBLIC_APPWRITE_BUCKET_ID=your-bucket-id-here

# Development Settings
NODE_ENV=development